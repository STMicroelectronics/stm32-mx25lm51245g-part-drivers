{
  "componentid": "::Board Part:STM32CubeMX2 Config:MX25LM51245G",
  "type": "object",
  "grammarVersion": "3.8.0",
  "license": "Copyright (c) 2026 STMicroelectronics",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "MX25LM51245G configuration",
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "SW Label for parts objects",
              "description": "Labels allow to create aliases inside mx_mx25lm51245g.h file for the object ID and object getter function. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            }
          }
        },
        "resourcesAllocation": {
          "title": "STM32 resources allocation",
          "type": "object",
          "properties": {
            "xspiCfg": {
              "type": "object",
              "title": "XSPI Interface Configuration",
              "description": "MX25LM51245G XSPI Interface configuration",
              "properties": {
                "xspi_instance": {
                  "type": "object",
                  "title": "XSPI Instance",
                  "description": "The XSPI peripheral must be configured in the HAL XSPI configuration panel",
                  "objectType": "bind.peripheral.config",
                  "criteria": {
                    "peripheralType": [
                      "ospi"
                    ]
                  },
                  "actions": [
                    {
                      "type": "error",
                      "condition": "!$resourcesAllocation.xspiCfg.xspi_instance?.selection",
                      "message": "Please select an XSPI instance configured in the Peripherals configuration panel."
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
